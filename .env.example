# Discord Dynamic Profile Widget credentials
DISCORD_APP_ID=
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=

# Recommended for reliable image display: upload processed PNGs to Discord CDN.
# Create a webhook in a private widget-assets channel.
DISCORD_IMAGE_WEBHOOK_URL=
# Alternative to webhook upload; bot needs Send Messages + Attach Files.
DISCORD_TARGET_CHANNEL_ID=

# Optional but recommended: remove backgrounds with remove.bg before Discord upload.
REMOVE_BG_API_KEY=

# Optional: root payload username Discord uses for widget binding
WIDGET_USERNAME=waifu-widget

# Image controls
DISABLE_IMAGE_FALLBACK=false
DISABLE_IMAGE_FIX=false
DISABLE_REMOVE_BG=false
WIDGET_IMAGE_FIT=cover
WIDGET_IMAGE_ZOOM=1.18

# Optional local testing mode; logs payload without PATCHing Discord or saving memory
DRY_RUN=false
